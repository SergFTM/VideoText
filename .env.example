ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-6

# Prisma reads DATABASE_URL at runtime (schema.prisma uses env()).
# The path is resolved relative to prisma/schema.prisma, so `file:videotext.db`
# → prisma/videotext.db. Swap to postgresql://... to migrate off SQLite.
DATABASE_URL=file:videotext.db
